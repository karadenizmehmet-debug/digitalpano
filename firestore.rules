rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Giriş Google ile. Yönetici sabit UID; diğerleri panelden onaylanınca, onaylandıkları okulda yazabilir.
    // Yönetici listesi src/lib/firebase.js içindeki ADMINS ile AYNI olmalı.
    function girisli() { return request.auth != null; }
    function admin() { return girisli() && request.auth.uid in ['j9o0PbL1OHQfxgX4wDrdf1G1qXj2']; }
    function kayit() { return /databases/$(database)/documents/kullanicilar/$(request.auth.uid); }
    function onayli() { return girisli() && exists(kayit()) && get(kayit()).data.durum == 'onayli'; }
    // okullar alanı yoksa yalnızca ana okul (config/pano)
    function okulYetki(id) { return onayli() && id in get(kayit()).data.get('okullar', ['pano']); }

    // Her okulun ayarı: config/pano (ana okul), config/pano-<yol> (diğerleri). Herkes okur.
    match /config/{id} {
      allow read: if true;
      allow write: if admin() || okulYetki(id);
    }
    // Görseller okullar arasında ortak koleksiyonda (kimlikler benzersiz).
    match /images/{id} {
      allow read: if true;
      allow write: if admin() || onayli();
    }
    // Okul listesi: herkes okur, yalnızca yönetici ekler/siler.
    match /okullar/{id} {
      allow read: if true;
      allow write: if admin();
    }
    // Başvurular: kişi yalnızca kendi kaydını "bekliyor" olarak açar; karar ve okul seçimi yöneticide.
    match /kullanicilar/{uid} {
      allow read: if admin() || (girisli() && request.auth.uid == uid);
      allow create: if girisli() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['durum', 'ad', 'eposta', 'foto', 'zaman'])
        && request.resource.data.durum == 'bekliyor';
      allow update, delete: if admin();
    }
  }
}
