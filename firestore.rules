rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pano herkese açık okur; yazma yalnızca panel sahibi hesaplardan (UID listesi).
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid in ['j9o0PbL1OHQfxgX4wDrdf1G1qXj2', 'zjV9H8U08KR6gQTpiNFcbTGvW8l1'];
    }
  }
}
