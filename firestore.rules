rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pano herkese açık okur; yazma yalnızca panel sahibi hesaptan.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'j9o0PbL1OHQfxgX4wDrdf1G1qXj2';
    }
  }
}
