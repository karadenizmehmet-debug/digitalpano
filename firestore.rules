rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pano herkese açık okur; yazma yalnızca panel sahibi hesaptan.
    // SAHIP_UID yerine Firebase Authentication'daki kendi kullanıcı UID'nizi yazın.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'SAHIP_UID';
    }
  }
}
