rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Giriş Google ile. Yönetici sabit UID; diğerleri panelden onaylanınca yazabilir.
    // Yönetici listesi src/lib/firebase.js içindeki ADMINS ile AYNI olmalı.
    function girisli() { return request.auth != null; }
    function admin() { return girisli() && request.auth.uid in ['j9o0PbL1OHQfxgX4wDrdf1G1qXj2']; }
    function onayli() {
      return girisli()
        && exists(/databases/$(database)/documents/kullanicilar/$(request.auth.uid))
        && get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.durum == 'onayli';
    }
    function yazar() { return admin() || onayli(); }

    // Pano herkese açık okur; yazma yönetici ya da onaylı kullanıcı.
    match /config/{id} {
      allow read: if true;
      allow write: if yazar();
    }
    match /images/{id} {
      allow read: if true;
      allow write: if yazar();
    }

    // Başvurular: kişi yalnızca kendi kaydını "bekliyor" olarak açar; kararı yönetici verir.
    match /kullanicilar/{uid} {
      allow read: if admin() || (girisli() && request.auth.uid == uid);
      allow create: if girisli() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['durum', 'ad', 'eposta', 'foto', 'zaman'])
        && request.resource.data.durum == 'bekliyor';
      allow update, delete: if admin();
    }
  }
}
